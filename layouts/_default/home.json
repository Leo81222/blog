{{- $pages := where .Site.RegularPages "Type" "in" (slice "post" "page") -}}
[ {{ range $index, $page := $pages }} {{ if $index }},{{ end }}
  {
    "objectID": {{ $page.File.UniqueID | jsonify }},
    "date": {{ $page.Date.UTC.Unix | jsonify }},
    "title": {{ $page.Title | jsonify }},
    "description": {{ $page.Description | jsonify }},
    "uri": {{ $page.Permalink | jsonify }},
    "content": {{ $page.Plain | jsonify }},
    "section": {{ $page.Section | jsonify }},
    "categories": {{ $page.Params.categories | jsonify }},
    "tags": {{ $page.Params.tags | jsonify }}
  } {{ end }} ]
